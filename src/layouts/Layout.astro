---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import NavItem from '../components/NavItem.astro';

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
		<script>
			const isDark = window.matchMedia("(prefers-color-scheme: dark)").matches
			if (isDark) {
				document.documentElement.classList.add("dark");
			} else {
				document.documentElement.classList.remove("dark");
			}
		</script>
	</head>
	<body>
		<main class="flex flex-col min-h-screen">
			<NavBar>
				<span slot="title">Giuseppe Sorrentino</span>
				<NavItem href="/">About</NavItem>
				<NavItem href="/experience/">Experience</NavItem>
				<NavItem href="/stack/">Stack</NavItem>
				<NavItem href="/projects/">Projects</NavItem>
			</NavBar>
			<div class="flex-1">
				<slot />
			</div>
			<footer class="flex py-4 max-lg:flex-col items-center justify-center bg-glsorre-40 quicksand-400 gap-4 text-sm dark:color-white color-black">
				<p><span class="quicksand-600">&copy; {new Date().getFullYear()}</span> glsorre.com</p>
				<p class="ml-4">Built with 🤍 by Giuseppe Sorrentino</p>
				<p>✉️ giuseppe [at] glsorre [dot] com</p>
			</footer>
		</main>
	</body>
</html>

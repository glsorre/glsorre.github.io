---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import NavItem from '../components/NavItem.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection("posts");
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
		<script>
			const isDark = window.matchMedia("(prefers-color-scheme: dark)").matches
			if (isDark) {
				document.documentElement.classList.add("dark");
			} else {
				document.documentElement.classList.remove("dark");
			}
		</script>
	</head>
	<body>
		<main class="flex flex-col min-h-screen">
			<NavBar>
				<a slot="title" href="/" class="block rounded quadratino py-3.5 pl-10 mr-2 h-[52px] w-[273px] kenney-600 text-xl">
					glsorre
				</a>
				<NavItem href="/">About</NavItem>
                {posts.length > 0 && <NavItem href="/blog/">Blog</NavItem>}
                <NavItem href="/experience/">Experience</NavItem>
			</NavBar>
			<div class="flex-1">
				<slot />
			</div>
			<footer class="flex py-4 max-xl:flex-col items-center justify-center bg-glsorre-40 quicksand-400 gap-4 text-sm dark:color-white color-black">
				<p><span class="quicksand-600">&copy; {new Date().getFullYear()}</span> glsorre.com</p>
				<p class="ml-4">Built with 🤍 by Giuseppe Sorrentino</p>
				<p>✉️ giuseppe [at] glsorre [dot] com</p>
			</footer>
		</main>
	</body>
</html>

<style>
	.quadratino {
        background: url('../assets/quadratino.svg') no-repeat 15px 20px;
        background-size: 13.75px;
    }
	
	.quadratino:hover {
		background: url('../assets/quadratino.svg') no-repeat 15px 20px white;
		background-size: 13.75px;
	}

	.dark .quadratino:hover {
		background: url('../assets/quadratino.svg') no-repeat 15px 20px black;
		background-size: 13.75px;
	}
</style>

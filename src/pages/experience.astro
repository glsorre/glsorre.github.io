---
import Layout from '../layouts/Layout.astro';
import Slide from '../components/Slide.astro';

import { getCollection, render } from 'astro:content';

const experiences = (await getCollection('experiences')).sort((a, b) => 
	b.data.end_year === 'Present' ? 1 : a.data.end_year === 'Present' ? -1 : b.data.end_year - a.data.end_year
);

const experiencesBodies = await Promise.all(
	experiences.map(async (exp) => {
		const { Content } = await render(exp);
		return Content;
	})
);
---

<Layout title="glsorre.com - Experience" description="Giuseppe Sorrentino AKA glsorre experience in the industry.">
	<main class="flex flex-col w-full min-h-full">
		<Slide prefix="work" title="Experience">
			{experiences.map((exp, index) => (
				<div class="flex flex-col animated">
					<h2 class:list={["text-xl pl-10", {spunta: index !== 0}, {cerchio: index === 0}]}>{exp.data.title}</h2>
					<div class="linea">
						<div class="flex max-xl:flex-col max-xl:justify-start justify-between">
							<p class="quicksand-600 ml-10 text-md">{exp.data.company}</p>
							<p class="quicksand-600 ml-10 text-md">{exp.data.start_year} - {exp.data.end_year}</p>
						</div>
						<div class="prose ml-10 pb-15 max-w-none">
							<experiencesBodies[experiences.indexOf(exp)] class="prose" />
						</div>
					</div>
				</div>
			))}
		</Slide>
		<Slide title="Education">
			<div class="flex flex-col animated">
				<h2 class="text-xl pl-10 spunta">MSc Human-Computer Interaction</h2>
				<div class="flex max-xl:flex-col max-xl:justify-start justify-between pb-15 linea">
					<p class="quicksand-600 ml-10 text-md">University College London</p>
					<p class="quicksand-600 ml-10 text-md">2009 - 2010</p>
				</div>
			</div>
			<div class="flex flex-col animated">
				<h2 class="text-xl pl-10 spunta">MSc Industrial Design</h2>
				<div class="flex max-xl:flex-col max-xl:justify-start justify-between pb-15 linea">
					<p class="quicksand-600 ml-10 text-md">Politecnico di Torino</p>
					<p class="quicksand-600 ml-10 text-md">2000 - 2006</p>
				</div>
			</div>
		</Slide>
	</main>
</Layout>

<style>
	.spunta {
		background: url('../assets/spunta.svg') no-repeat left 5px;
		background-size: 18px;
	}
	.cerchio {
		background: url('../assets/cerchio.svg') no-repeat left 5px;
		background-size: 18px;
	}
	.linea {
		position: relative;
	}
	.linea::before {
		content: ' ';
		display: block;
		position: absolute;
		background: #95c389;
		margin-left: 7px;
		width: 4px;
		top: 0;
		bottom: 0;
		z-index: -1;
	}

	@keyframes slide-in {
		from { opacity: 0; transform: scale(0); }
		to   { opacity: 1; transform: scale(1);}
	}

	.animated {
		opacity: 0;
		transform: scale(0);

		animation-name: slide-in;
		animation-duration: 600ms;
		animation-fill-mode: both;
		animation-timeline: view();
		animation-range: entry -100% entry 100%;
	}
</style>

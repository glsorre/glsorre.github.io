---
import Layout from '../layouts/Layout.astro';
import Slide from '../components/Slide.astro';
---

<Layout title="Giuseppe Sorrentino - Experience" description="I'm Giuseppe Sorrentino, a software engineer with experience in creating and delivering digital products.">
	<main class="flex flex-row w-full min-h-full">
		<Slide prefix="Tech" title="Stack">
			<p class="quicksand-600 min-lg:pl-10 pt-2 pb-4 text-md">Here are some of the technologies and tools I work with:</p>
			<ul class="grid max-lg:grid-cols-1 grid-cols-3 gap-6 min-lg:pl-10">
				<div class="bg-glsorre-40 p-4 rounded-2xl text-center flex flex-col">
					<div class="text-4xl p-8">
						<i class="bi bi-cursor"></i>
					</div>
					<div class="text-left flex flex-col justify-between flex-1 gap-3 min-h-30">
						<h3 class="quicksand-600 text-2xl">Languages</h3>
						<p>JavaScript (ES6+), TypeScript, Python, Go, Rust, C#, HTML5, CSS3 (Sass, Less, Tailwind)</p>
					</div>
				</div>
				<div class="bg-glsorre-40 p-4 rounded-2xl text-center flex flex-col">
					<div class="text-4xl p-8">
						<i class="bi bi-cursor"></i>
					</div>
					<div class="text-left flex flex-col justify-between flex-1 gap-3 min-h-30">
						<h3 class="quicksand-600 text-2xl">Frontend & State Management</h3>
						<p>React, VueJS, AlpineJS, SingleSPA, Webpack, Vite, Redux, Pinia, Zustand, MobX</p>
					</div>
				</div>
				<div class="bg-glsorre-40 p-4 rounded-2xl text-center flex flex-col">
					<div class="text-4xl p-8">
						<i class="bi bi-hdd-stack"></i>
					</div>
					<div class="text-left flex flex-col justify-between flex-1 gap-3 min-h-30">
						<h3 class="quicksand-600 text-2xl">Backend & API</h3>
						<p> Node.js (Express), Python (Django, Flask, FastAPI), Rust (Axum), .NET, REST, GraphQL, gRPC</p>
					</div>
				</div>
				<div class="bg-glsorre-40 p-4 rounded-2xl text-center flex flex-col">
					<div class="text-4xl p-8">
						<i class="bi bi-database"></i>
					</div>
					<div class="text-left flex flex-col justify-between flex-1 gap-3 min-h-30">
						<h3 class="quicksand-600 text-2xl">Databases</h3>
						<p> PostgreSQL, MySQL, DynamoDB, MongoDB, DocumentDB</p>
					</div>
				</div>
				<div class="bg-glsorre-40 p-4 rounded-2xl text-center flex flex-col">
					<div class="text-4xl p-8">
						<i class="bi bi-truck"></i>
					</div>
					<div class="text-left flex flex-col justify-between flex-1 gap-3 min-h-30">
						<h3 class="quicksand-600 text-2xl">Cloud & DevOps</h3>
						<p>AWS, GCP, Azure, Docker, Kubernetes, Terraform, Jenkins, GitHub Actions, GitLab CI
						</p>
					</div>
				</div>
				<div class="bg-glsorre-40 p-4 rounded-2xl text-center flex flex-col">
					<div class="text-4xl p-8">
						<i class="bi bi-window-stack"></i>
					</div>
					<div class="text-left flex flex-col justify-between flex-1 gap-3 min-h-30">
						<h3 class="quicksand-600 text-2xl">Desktop & Mobile</h3>
						<p> SwiftUI, WinUI, WPF, Flutter, ReactNative</p>
					</div>
				</div>
				<div class="bg-glsorre-40 p-4 rounded-2xl text-center flex flex-col">
					<div class="text-4xl p-8">
						<i class="bi bi-nut"></i>
					</div>
					<div class="text-left flex flex-col justify-between flex-1 gap-3 min-h-30">
						<h3 class="quicksand-600 text-2xl">Methodologies</h3>
						<p>Agile, TDD, BDD, Specification Driven Development, UX Design</p>
					</div>
				</div>
			</ul>
		</Slide>
	</main>
</Layout>

<style>
	.spunta {
		background: url('src/assets/spunta.svg') no-repeat left 5px;
		background-size: 18px;
	}
	.cerchio {
		background: url('src/assets/cerchio.svg') no-repeat left 5px;
		background-size: 18px;
	}
	.linea {
		position: relative;
	}
	.linea::before {
		content: ' ';
		display: block;
		position: absolute;
		background: #95c389;
		margin-left: -29px;
		width: 4px;
		top: 0;
		bottom: 0;
		z-index: -1;
	}
</style>

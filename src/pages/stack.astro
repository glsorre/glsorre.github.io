---
import Layout from '../layouts/Layout.astro';
import Slide from '../components/Slide.astro';

import { getCollection } from 'astro:content';

const stack = (await getCollection('stack')).sort((a, b) => 
	a.data.order - b.data.order
);
---

<Layout title="Giuseppe Sorrentino - Experience" description="I'm Giuseppe Sorrentino, a software engineer with experience in creating and delivering digital products.">
	<main class="flex flex-row w-full min-h-full">
		<Slide prefix="Tech" title="Stack">
			<ul class="grid max-lg:grid-cols-1 grid-cols-3 gap-6 min-lg:pl-10">
				{stack.map((item) => (
					<li class="bg-glsorre-40 p-4 rounded-2xl text-center flex flex-col">
						<div class="text-4xl p-8">
							<i class:list={{ "bi": true, [item.data.icon]: true }}"></i>
						</div>
						<div class="text-left flex flex-col justify-between flex-1 gap-3 min-h-30">
							<h3 class="quicksand-600 text-2xl">{item.data.title}</h3>
							<p>{item.data.skills}</p>
						</div>
					</li>
				))}
			</ul>
		</Slide>
	</main>
</Layout>

<style>
	.spunta {
		background: url('src/assets/spunta.svg') no-repeat left 5px;
		background-size: 18px;
	}
	.cerchio {
		background: url('src/assets/cerchio.svg') no-repeat left 5px;
		background-size: 18px;
	}
	.linea {
		position: relative;
	}
	.linea::before {
		content: ' ';
		display: block;
		position: absolute;
		background: #95c389;
		margin-left: -29px;
		width: 4px;
		top: 0;
		bottom: 0;
		z-index: -1;
	}
</style>

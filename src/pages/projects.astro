---
import Layout from '../layouts/Layout.astro';
import Slide from '../components/Slide.astro';

import { getCollection } from 'astro:content';
const links = (await getCollection('links')).sort((a, b) => 
	new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout title="Giuseppe Sorrentino - Projects" description="I'm Giuseppe Sorrentino, a software engineer with experience in creating and delivering digital products.">
	<main class="flex flex-row w-full min-h-full">
		<Slide title="Projects">
			<ol class="min-lg:pl-10 list-decimal flex flex-col gap-3">
				{links.map((link) => (
					<a href={link.data.anchor} target={link.data.target || "_self"} rel="noopener noreferrer" class="flex items-center justify-between bg-glsorre-40 p-4 rounded-2xl hover:scale-[1.02] transition-transform group">
						<div>
							<h3 class="quicksand-600 text-2xl capitalize">{link.data.title}</h3>
							<p class="pt-2 text-md">{link.data.desc}</p>
						</div>
						<i class="bi bi-caret-right opacity-0 text-4xl group-hover:opacity-100 transition-opacity"></i>
					</a>
				))}
			</ol>
		</Slide>
	</main>
</Layout>

<style>
	header p span {
		background: url('src/assets/marchio right right.svg') no-repeat left center;
		background-size: 24.5px;
	}
</style>

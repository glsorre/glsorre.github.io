---
import Layout from '../layouts/Layout.astro';
import Slide from '../components/Slide.astro';
import BlogItem from '../components/BlogItem.astro';

import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
	.filter((post) => new Date(post.data.date) <= Date.now())
	.sort((a, b) => 
		new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
	)

const latestPosts = posts.slice(0, 3);
---

<Layout title="Giuseppe Sorrentino AKA glsorre - About" description="I'm Giuseppe Sorrentino AKA glsorre, a software engineer with 10+ years of experience in the industry.">
	<main class="flex flex-col w-full">
		<Slide prefix="Hello, I am" title="Giuseppe">
			<ul class="pl-14 pb-10 list-disc flex flex-col gap-8">
				<li>
					<strong>Senior software engineer</strong>, 10+ years in. Currently at <strong>Fincons</strong>.
				</li>
				<li>
					I build <strong>opinionated tools for power users</strong> across native desktop (Swift, C#) and modern web (TypeScript, Vue, React).
				</li>
				<li>
					Most days I'm thinking about <strong>how to ship well as a solo developer</strong> — design, distribution.
				</li>		
			</ul>
			<a target="_blank" href="https://www.rightright.me">
				<p class="px-10 bg-right-right-40 hover:bg-right-right-60 p-4 rounded transition-background inline-block">
					Outside work I build tools for power users at <span class="logo-right-right kenney-600 text-2xl pl-6 ml-2">right right</span>
				</p>
			</a>
		</Slide>
		{latestPosts.length > 0 && <Slide prefix="Writing about" title="software engineering">
			<ol class="min-xl:pl-10 flex flex-col gap-3">
				{latestPosts.map((post, index) => (
					<BlogItem {...post.data} />
                ))}
				{latestPosts.length > 3 && <a href="/blog/" class="flex min-md:w-[33%] min-md:mx-auto flex-col rounded-full border-2 border-glsorre kenney-600 p-2 gap-3 rounded hover:scale-[1.02] transition-all group text-glsorre text-center">
					view all posts
				</a>}
            </ol>
		</Slide>}
	</main>
</Layout>

<style>
	.logo-right-right {
		background: url('../assets/marchio right right.svg') no-repeat left center;
		background-size: 17px;
	}
</style>

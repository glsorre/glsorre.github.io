---
import Layout from '../layouts/Layout.astro';
import Slide from '../components/Slide.astro';

import { getCollection } from 'astro:content';
const links = (await getCollection('links')).sort((a, b) => 
	new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout title="Giuseppe Sorrentino - About" description="I'm Giuseppe Sorrentino, a software engineer specialized in shortening time-to-market of digital products.">
	<main class="flex w-full">
		<Slide prefix="I'm a" title="software engineer">
			<ul class="pl-14 pb-20 list-disc flex flex-col gap-4">
				<li>
					<div class="flex flex-col gap-4">
						<p>Over <strong>10 years of experience</strong> in software development</p>
						<div>
							<a href="/experience/" class="bg-glsorre-40 hover:bg-glsorre-60 p-2 rounded trasition-background quicksand-500">Check my Experience</a>
						</div>
					</div>
				</li>
				<li>
					<div class="flex gap-4 flex-col">
						<p>Passionate about <strong>creating delightful digital products</strong> for web, mobile, and desktop</p>
						<div>
							<a href="/projects/" class="bg-glsorre-40 hover:bg-glsorre-60 p-2 rounded trasition-background quicksand-500">See my Projects</a>
						</div>
					</div>
				</li>
				<li>
					<div class="flex gap-4 flex-col">
						<p>Full-stack, <strong>frontend oriented</strong></p>
						<div>
							<a href="/projects/" class="bg-glsorre-40 hover:bg-glsorre-60 p-2 rounded trasition-background quicksand-500">Discover my Stack</a>
						</div>
					</div>
				</li>		
			</ul>
			<a target="_blank" href="https://www.rightright.me">
				<p class="px-10 bg-right-right-40 hover:bg-right-right-60 p-4 rounded transition-background inline-block">
					In my free time I work on digital products at <span class="logo-right-right kenney-600 text-2xl pl-6 ml-2">right right</span>
				</p>
			</a>
		</Slide>
	</main>
</Layout>

<style>
	.logo-right-right {
		background: url('../assets/marchio right right.svg') no-repeat left center;
		background-size: 17px;
	}
</style>

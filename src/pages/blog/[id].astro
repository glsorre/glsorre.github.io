---
import Slide from '../../components/Slide.astro';
import Layout from '../../layouts/Layout.astro';

import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  console.log(posts);
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`Giuseppe Sorrentino AKA glsorre - ${post.data.title}`} description={post.data.subtitle}>
  <Slide title={post.data.title}>
    <div class="prose min-xl:pl-10 max-w-none mb-10">
      <Content />
    </div>
    <script src="https://giscus.app/client.js"
      data-repo="glsorre/glsorre.github.io"
      data-repo-id="MDEwOlJlcG9zaXRvcnk3NjI4NTA2Nw=="
      data-category="General"
      data-category-id="DIC_kwDOBIwEi84C9YM0"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="preferred_color_scheme"
      data-lang="en"
      data-loading="lazy"
      crossorigin="anonymous"
        async>
    </script>
  </Slide>
</Layout>

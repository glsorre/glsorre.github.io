---
import NavItem from "./NavItem.astro";
import { getCollection } from 'astro:content';

const posts = await getCollection("posts");
---

<nav class="bg-glsorre-40">
    <div
        class="max-xl:w-[80%] w-[50%] m-auto flex justify-between items-center py-10 h[55px]"
    >
        <slot name="title" />
        <ul class="flex max-xl:hidden gap-5 quicksand-600">
            <slot />
        </ul>
        <button class="min-xl:hidden text-3xl hamburger" popovertarget="mobile-menu">
        </button>
    </div>
    <div id="mobile-menu" class="fixed size-auto bg-white dark:bg-black m-5 shadow-md rounded" popover>
        <div
            class="absolute size-auto top-5 bottom-5 left-5 right-5"
        >
            <div class="flex items-center justify-between pt-3 pb-6">
                <p class="kenney-600 text-xl quadratino ml-4 pl-6">glsorre</p>
                <button class="text-3xl croce" popovertarget="mobile-menu">
                </button>
            </div>
            <ul class="flex flex-col gap-1 quicksand-600">
                <NavItem mobile href="/">About</NavItem>
                {posts.length > 0 && <NavItem mobile href="/blog/">Blog</NavItem>}
                <NavItem mobile href="/experience/">Experience</NavItem>
            </ul>
        </div>
    </div>
</nav>

<style>
    .quadratino {
        background: url("../assets/quadratino.svg") no-repeat left 6.5px;
        background-size: 13.75px;
    }

    .hamburger {
        mask: url("../assets/menu.svg") no-repeat center;
        mask-size: 24px;
        width: 28px;
        height: 28px;
        cursor: pointer;
        background-color: black;
    }

    html.dark .hamburger {
        background-color: white;
    }

    .croce {
        mask: url("../assets/croce.svg") no-repeat center;
        mask-size: 24px;
        width: 28px;
        height: 28px;
        cursor: pointer;
        background-color: black;
    }

    html.dark .croce {
        background-color: white;
    }

    [popover]:popover-open {
        opacity: 1;
        transform: scaleX(1);
    }

    [popover] {
        opacity: 0;
        transform: scaleX(0);
        transition:
            opacity 0.3s,
            transform 0.3s,
            overlay 0.3s allow-discrete,
            display 0.3s allow-discrete;
        color: black;
    }

    html.dark [popover] {
        color: white;
    }

    @starting-style {
        [popover]:popover-open {
            opacity: 0;
            transform: scaleX(0);
        }
    }

    [popover]::backdrop {
        background-color: transparent;
        transition:
            display 0.3s allow-discrete,
            overlay 0.3s allow-discrete,
            background-color 0.3s;
    }

    [popover]:popover-open::backdrop {
        background-color: rgb(0 0 0 / 40%);
    }

    @starting-style {
        [popover]:popover-open::backdrop {
            background-color: transparent;
        }
    }
</style>

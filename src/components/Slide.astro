---
import SectionHeader from './SectionHeader.astro';

const { prefix, title } = Astro.props;
---

<section class="w-full h-full flex" x-data="{ shown: false }">
    <div class="max-xl:w-[80%] w-[50%] flex flex-col m-auto mt-[12.5vh] py-20">
        <SectionHeader prefix={prefix} title={title} />
        <slot />
    </div>
</section>
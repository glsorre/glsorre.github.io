---
import SectionHeader from './SectionHeader.astro';

const { prefix, title } = Astro.props;
---

<section class="w-full h-full flex animated">
    <div class="max-xl:w-[80%] w-[50%] flex flex-col m-auto my[2.5vh] py-20">
        <SectionHeader prefix={prefix} title={title} />
        <slot />
    </div>
</section>

<style>
    @keyframes slide-in {
		from { opacity: 0; transform: scale(0); }
		to   { opacity: 1; transform: scale(1);}
	}

	.animated {
		opacity: 0;
		transform: scale(0);

		animation-name: slide-in;
		animation-duration: 300ms;
		animation-fill-mode: both;
	}
</style>
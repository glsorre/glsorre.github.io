---
const { href, mobile } = Astro.props;
const active = Astro.url.pathname === href;
---

<li class="my-2" x-data={`{ active: ${active}, mobile: ${mobile} }`}>
    <a :class="{'p-4 rounded-2xl': true, 'bg-white dark:bg-black': active && !mobile, 'bg-glsorre-40': active && mobile}" href={href}>
        <slot />
    </a>
</li>
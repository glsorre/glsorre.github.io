---
const { href, mobile } = Astro.props;
---

<li x-data={`{ active: window.location.pathname === '${href}', mobile: ${mobile} }`}>
    <a :class="{'p-4 rounded hover:bg-white hover:dark:bg-black': true, 'bg-white dark:bg-black': active && !mobile, 'bg-glsorre-40': active && mobile}" href={href}>
        <slot />
    </a>
</li>